# Model Configuration
# Choose a predefined model type: phi4, gemma, gemma3n, llava, moondream, ollama
LLM_MODEL_TYPE=phi4

# Or specify a custom HuggingFace model
# LLM_MODEL_NAME=google/gemma-3n-vision

# Ollama Configuration (only when LLM_MODEL_TYPE=ollama)
# Model name for Ollama (phi4, llava, bakllava, etc.)
# LLM_MODEL_NAME=phi4
# Ollama server URL
# OLLAMA_HOST=http://localhost:11434

# Device Configuration
# Use 'cpu' for CPU inference or 'cuda' for GPU (not used with ollama)
DEVICE=cpu

# Server Configuration
# ⚠️  IMPORTANT: On Lightning.ai, port 8000 is reserved by the platform.
# You MUST use a different port (e.g., 8001) to avoid conflicts.
FASTAPI_PORT=8001
GRPC_PORT=50051
GRADIO_PORT=7860

# Lightning.ai Configuration (optional)
# LIGHTNING_API_KEY=your_api_key_here
